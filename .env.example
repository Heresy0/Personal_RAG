PERSONAL_RAG_DATABASE_URL=postgresql://personal_rag:REPLACE_ME@127.0.0.1:55432/personal_rag
PERSONAL_RAG_VAULT=knowledge_workspace/vault
# disabled: usable keyword search, no network model calls.
# openai-compatible: explicitly enable real semantic embeddings using your chosen provider.
PERSONAL_RAG_EMBEDDING_PROVIDER=disabled
PERSONAL_RAG_EMBEDDING_URL=
PERSONAL_RAG_EMBEDDING_MODEL=
PERSONAL_RAG_EMBEDDING_DIMENSIONS=1024
PERSONAL_RAG_EMBEDDING_API_KEY=
PERSONAL_RAG_RERANK_URL=
PERSONAL_RAG_RERANK_MODEL=
PERSONAL_RAG_RERANK_API_KEY=
# Optional durable fallback directory; Docker uses the ./logs bind mount.
# PERSONAL_RAG_AUDIT_DIR=knowledge_workspace/logs
# Optional mail collector; use provider-generated client authorization codes, not login passwords.
PERSONAL_RAG_MAIL_QQ_AUTH_CODE=
PERSONAL_RAG_MAIL_163_AUTH_CODE=
