{
  "gateway": {
    "mode": "local", "port": 19889, "bind": "loopback",
    "auth": { "mode": "token", "token": "GATEWAY_TOKEN" }
  },
  "agents": {
    "defaults": {
      "workspace": "LAB_ROOT/workspace",
      "model": { "primary": "MODEL_ID" },
      "heartbeat": { "every": "0m" }
    }
  },
  "session": { "dmScope": "per-account-channel-peer" },
  "plugins": {
    "allow": ["codex", "openclaw-weixin", "openai"],
    "load": { "paths": ["LAB_ROOT/runtime/node_modules/@tencent-weixin/openclaw-weixin"] },
    "slots": { "memory": "none" },
    "entries": {
      "openclaw-weixin": { "enabled": true },
      "openai": { "enabled": true },
      "codex": {
        "enabled": true,
        "config": {
          "appServer": {
            "homeScope": "user", "command": "CODEX_EXECUTABLE",
            "mode": "guardian", "approvalPolicy": "on-request",
            "sandbox": "workspace-write", "approvalsReviewer": "auto_review",
            "defaultWorkspaceDir": "LAB_ROOT/workspace",
            "args": [
              "-c", "mcp_servers.personal_memory.command=\"pwsh\"",
              "-c", "mcp_servers.personal_memory.args=[\"-NoLogo\",\"-NoProfile\",\"-File\",\"MEMORY_LAUNCHER\"]",
              "-c", "mcp_servers.personal_memory.enabled=true",
              "-c", "mcp_servers.personal_memory.startup_timeout_sec=90",
              "-c", "mcp_servers.personal_memory.tool_timeout_sec=120",
              "app-server", "--listen", "stdio://"
            ]
          },
          "sessionCatalog": { "enabled": false },
          "codexPlugins": {
            "enabled": true, "allow_all_plugins": false,
            "plugins": { "personal-memory": {
              "enabled": true, "marketplaceName": "personal-rag", "pluginName": "personal-memory"
            } }
          }
        }
      }
    }
  },
  "commands": { "ownerAllowFrom": ["openclaw-weixin:WEIXIN_OWNER_ID"] },
  "mcp": { "servers": { "personal_memory": {
    "command": "pwsh", "args": ["-NoLogo", "-NoProfile", "-File", "MEMORY_LAUNCHER"],
    "enabled": true, "requestTimeoutMs": 120000, "connectionTimeoutMs": 90000,
    "supportsParallelToolCalls": false,
    "codex": { "agents": ["main"], "defaultToolsApprovalMode": "approve" },
    "toolFilter": { "include": ["memory_status", "set_memory_mode", "search_notes", "read_note", "get_timeline", "capture_note"] }
  } } }
}
